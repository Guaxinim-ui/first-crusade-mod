{
  "multipart": [
    {
      "apply": {
        "model": "firstcrusade:block/hive_grate_post"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "firstcrusade:block/hive_grate_side"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "firstcrusade:block/hive_grate_side",
        "y": 90
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "firstcrusade:block/hive_grate_side",
        "y": 180
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "firstcrusade:block/hive_grate_side",
        "y": 270
      }
    },
    {
      "when": {
        "north": "false"
      },
      "apply": {
        "model": "firstcrusade:block/hive_grate_noside"
      }
    },
    {
      "when": {
        "east": "false"
      },
      "apply": {
        "model": "firstcrusade:block/hive_grate_noside",
        "y": 90
      }
    },
    {
      "when": {
        "south": "false"
      },
      "apply": {
        "model": "firstcrusade:block/hive_grate_noside",
        "y": 180
      }
    },
    {
      "when": {
        "west": "false"
      },
      "apply": {
        "model": "firstcrusade:block/hive_grate_noside",
        "y": 270
      }
    }
  ]
}